---
import { Image } from 'astro:assets';
import Logo from '../components/Logo.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { catalog, categoryImages, categoryLabels, categoryOrder } from '../data/catalog';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/hero/condolence-hero-premium.png';
import wordmark from '../assets/brand/letras-logo.png';

const title = 'Catálogo de condolencias | Floristería Conce';
const description = 'Arreglos florales de condolencias en Concepción. Revisa nuestro catálogo de canastillos, cubre urnas, conjuntos y coronas florales.';
---

<BaseLayout title={title} description={description} ogImage={heroImage.src}>
  <div data-page="home">
    <header class="site-header">
      <a class="site-header__brand" href="#inicio" aria-label="Ir al inicio">
        <Logo decorative />
        <Image
          class="site-header__wordmark"
          src={wordmark}
          alt=""
          widths={[220, 432]}
          sizes="(max-width: 799px) 120px, 180px"
          loading="eager"
          decoding="async"
        />
      </a>
      <button class="site-header__menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label="Abrir menú" data-menu-toggle>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
      <nav class="site-nav" id="site-navigation" aria-label="Navegación principal" data-menu>
        <a href="#catalogo">Catálogo</a>
        <a href="#como-consultar">Pasos a seguir</a>
        <a href="#ubicacion">Ubicación</a>
      </nav>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero__background" aria-hidden="true">
          <Image
            class="hero__background-image"
            src={heroImage}
            alt=""
            widths={[900, 1200, 1600]}
            sizes="100vw"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </div>
        <div class="hero__orb hero__orb--one" aria-hidden="true"></div>
        <div class="hero__orb hero__orb--two" aria-hidden="true"></div>
        <div class="hero__content shell">
          <div class="hero__copy">
            <p class="eyebrow" data-hero-item>Catálogo de condolencias · Concepción</p>
            <h1 id="hero-title" data-hero-item>
              Flores para<br />acompañar con <em>respeto.</em>
            </h1>
            <p class="hero__lead" data-hero-item>
              Una selección de arreglos florales para expresar cercanía, cariño y presencia en momentos delicados.
            </p>
            <div class="hero__actions" data-hero-item>
              <a class="button button--dark" href="#catalogo">
                Explorar arreglos
                <span aria-hidden="true">↘</span>
              </a>
              <p>Valores en CLP<br />Consulta disponibilidad</p>
            </div>
          </div>

        </div>
      </section>

      <section class="catalog-section" id="catalogo" aria-labelledby="catalog-title">
        <header class="catalog-heading shell">
          <div data-reveal>
            <p class="eyebrow">Catálogo</p>
            <h2 id="catalog-title">Arreglos para<br /><em>acompañar.</em></h2>
          </div>
          <p data-reveal>
            Diez alternativas seleccionadas. Las flores y tonalidades pueden variar según disponibilidad, manteniendo el estilo y valor de cada arreglo.
          </p>
        </header>

        <div class="catalog shell">
          {categoryOrder.map((category, categoryIndex) => {
            const products = catalog.filter((product) => product.category === category);
            const categoryImage = categoryImages[category];
            return (
              <details class="catalog-group" data-catalog-group>
                <summary class="catalog-group__heading">
                  <span>{String(categoryIndex + 1).padStart(2, '0')}</span>
                  <h3 id={`category-${category}`}>{categoryLabels[category]}</h3>
                  <span class="catalog-group__image" aria-hidden="true">
                    <Image
                      src={categoryImage}
                      alt=""
                      widths={[240, 400]}
                      sizes="(max-width: 799px) 88px, 220px"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="catalog-group__action" aria-hidden="true">
                    <i class="catalog-group__toggle"></i>
                  </span>
                </summary>
                <div class="catalog-group__content">
                  <div class:list={['product-grid', products.length === 1 && 'product-grid--single']}>
                    {products.map((product) => (
                      <ProductCard product={product} />
                    ))}
                  </div>
                </div>
              </details>
            );
          })}
        </div>

      </section>

      <section class="consultation" id="como-consultar" aria-labelledby="consultation-title">
        <div class="consultation__botanical consultation__botanical--left" aria-hidden="true"></div>
        <div class="consultation__botanical consultation__botanical--right" aria-hidden="true"></div>
        <div class="consultation__inner shell">
          <header class="consultation__heading" data-reveal>
            <p class="eyebrow">Estamos para orientarte</p>
            <h2 id="consultation-title">Consulta<br /><span class="consultation__en">en</span><em>tres pasos.</em></h2>
          </header>
          <ol class="steps">
            <li>
              <span>01</span>
              <h3>Elige una referencia</h3>
              <p>Revisa el catálogo y guarda el nombre del arreglo.</p>
            </li>
            <li>
              <span>02</span>
              <h3>Escríbenos</h3>
              <p>Escríbenos por WhatsApp con la referencia elegida.</p>
            </li>
            <li>
              <span>03</span>
              <h3>Confirma disponibilidad</h3>
              <p>Confirmamos disponibilidad y coordinamos la preparación.</p>
            </li>
          </ol>
        </div>
      </section>

      <section class="closing" id="ubicacion" aria-labelledby="closing-title">
        <div class="closing__inner shell" data-reveal>
          <div class="closing__content">
            <Logo class="closing__logo" />
            <h2 id="closing-title">
              Un gesto de <span class="closing__pink">cariño</span><br />
              en el <span class="closing__green">momento indicado.</span>
            </h2>
            <p>Atención por WhatsApp</p>
            <p class="closing__phone">+56 9 8751 0974</p>
          </div>
          <div class="closing__map">
            <iframe
              title="Ubicación de Floristería Conce"
              src="https://www.google.com/maps?q=Caupolic%C3%A1n%20673%2C%20Local%20L1-A%2C%204030000%20Concepci%C3%B3n%2C%20B%C3%ADo%20B%C3%ADo%2C%20Chile&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <p>© {new Date().getFullYear()} Floristería Conce</p>
      <p>Catálogo de condolencias · Concepción, Chile</p>
      <a href="#inicio">Volver arriba ↑</a>
    </footer>

    <WhatsAppButton />
  </div>

  <script>
    const header = document.querySelector<HTMLElement>('.site-header');
    const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');

    if (header && menuToggle && menu) {
      const setMenuOpen = (isOpen: boolean) => {
        header.classList.toggle('site-header--menu-open', isOpen);
        document.body.classList.toggle('menu-is-open', isOpen);
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        menuToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      };

      menuToggle.addEventListener('click', () => {
        setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || menuToggle.getAttribute('aria-expanded') !== 'true') return;
        setMenuOpen(false);
        menuToggle.focus();
      });

      window.matchMedia('(min-width: 800px)').addEventListener('change', (event) => {
        if (event.matches) setMenuOpen(false);
      });
    }

    import '../scripts/animations';
  </script>
</BaseLayout>
